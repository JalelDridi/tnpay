{
  "name": "@tnpay/flouci",
  "version": "0.1.0",
  "description": "Typed Flouci (flouci.com) client for TypeScript, with a webhook handler that verifies every payment with Flouci before acting, and a fake Flouci server for tests.",
  "license": "MIT",
  "author": "Mohamed Jalel Dridi",
  "repository": {
    "type": "git",
    "url": "https://github.com/JalelDridi/tnpay.git",
    "directory": "packages/flouci"
  },
  "homepage": "https://github.com/JalelDridi/tnpay#readme",
  "keywords": [
    "flouci",
    "flouci.com",
    "tunisia",
    "payments",
    "payment-gateway",
    "webhook",
    "tnd",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fake": "./src/fake/index.ts"
  },
  "bin": {
    "tnpay-flouci": "./dist/fake/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tnpay/core": "workspace:*"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./fake": {
        "types": "./dist/fake/index.d.ts",
        "import": "./dist/fake/index.js",
        "require": "./dist/fake/index.cjs"
      }
    },
    "bin": {
      "tnpay-flouci": "./dist/fake/cli.js"
    }
  }
}
